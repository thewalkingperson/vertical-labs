# Copy this file to .env. Git ignores .env. Leave a value empty if you do not use it.
# Wingline fills only variables that are unset. An exported variable wins.

# xAI key from https://console.x.ai. Used when you are not signed in with `grok login`.
XAI_API_KEY=

# Used only if a model in ~/.grok/config.toml sets env_key to this name.
OPENAI_API_KEY=

# Model passed to `grok -m`. Default is grok-4.7. Use a name `grok models` lists.
# WINGLINE_MODEL=grok-4.7
